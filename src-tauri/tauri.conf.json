{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Otty",
  "version": "0.1.0",
  "identifier": "io.appmakes.otty.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Otty",
        "width": 1080,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
