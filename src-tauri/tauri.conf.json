{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Belfry",
  "version": "0.9.1",
  "identifier": "io.appmakes.belfry.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Belfry",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1080,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ChengSoon/belfry-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNzkwRTkzMDREMjFDQUQKUldTdEhOSUVrdzU1N010U0c4K1hIdnNyNm05aFBWVFhrby9pOTQzdjdvMTN0NHRuVklPQ2pNcVQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
